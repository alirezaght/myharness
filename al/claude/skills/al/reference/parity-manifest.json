    "reference_rationales": {
      "distribution.md": "The command must select the target harness platform (`codex` or `claude`); every registry, provenance, preservation, and recovery rule is otherwise shared.",
      "handoffs.md": "Harness handoffs use platform-specific repository-policy names, task-argument placeholders, and continuation APIs; review-stage isolation, typed approved inputs, inspected hashes, and evidence contracts are shared.",
      "parallelism.md": "The available agent invocation, continuation, isolation, and progress APIs differ by harness; write ownership, non-overlapping scope, failure handling, and no-mid-write interruption policy are shared.",
      "routing.md": "The user-facing skill invocation name is `$al` in Codex and `/al` in Claude; classification and execution paths are shared."
    },
    "native_adapter_rationales": {
      "al_native_sessions.py": "This adapter maps Claude conversation identities to immutable AL run IDs and serializes per-conversation pointer/statusline behavior; Codex uses its repository-scoped current-run pointer."
    }
  }
