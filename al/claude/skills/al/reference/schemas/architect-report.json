{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "architect-report-v2",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "stage",
    "invocation_id",
    "reviewer_role",
    "model",
    "task_hash",
    "candidate_hash",
    "packet_hash",
    "inspected_artifacts",
    "criteria",
    "findings",
    "status",
    "kind",
    "document_hash",
    "verification_authority_hash",
    "attempt_id",
    "effort",
    "policy_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "review_id": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "fresh",
        "compare"
      ]
    },
    "invocation_id": {
      "type": "string"
    },
    "reviewer_role": {
      "const": "al-architect"
    },
    "model": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "effort": {
      "type": "string",
      "minLength": 1
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_hash": {
      "type": "string"
    },
    "candidate_hash": {
      "type": "string"
    },
    "packet_hash": {
      "type": "string"
    },
    "inspected_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "rationale",
          "locations",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "SATISFIED",
              "UNSATISFIED"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "locations": {
            "$ref": "#/$defs/locations"
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "severity",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "BLOCKING",
              "NON_BLOCKING"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "object",
            "required": [
              "status",
              "rationale"
            ],
            "properties": {
              "status": {
                "enum": [
                  "fixed",
                  "disputed",
                  "deferred"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "locations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/location"
                }
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "status": {
                      "const": "fixed"
                    }
                  }
                },
                "then": {
                  "required": [
                    "locations",
                    "evidence"
                  ],
                  "properties": {
                    "locations": {
                      "$ref": "#/$defs/locations"
                    },
                    "evidence": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    }
                  }
                }
              }
            ]
          }
        }
      }
    },
    "prior_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "status",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "status": {
            "enum": [
              "fixed",
              "unresolved",
              "deferred",
              "disputed"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "locations": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/location"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "fixed"
                }
              }
            },
            "then": {
              "required": [
                "locations",
                "evidence"
              ],
              "properties": {
                "locations": {
                  "$ref": "#/$defs/locations"
                },
                "evidence": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "plan_defects": {
      "type": "array"
    },
    "assessments": {
      "type": "object",
      "required": [
        "rollout",
        "ui"
      ],
      "properties": {
        "rollout": {
          "type": "object",
          "required": [
            "applicable",
            "reason"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "expand_contract": {
              "properties": {
                "artifacts": {
                  "type": "array",
                  "items": {
                    "$ref": "artifact-reference.json"
                  }
                }
              }
            },
            "deployment_order": {
              "properties": {
                "artifacts": {
                  "type": "array",
                  "items": {
                    "$ref": "artifact-reference.json"
                  }
                }
              }
            },
            "aggregator_environment": {
              "properties": {
                "artifacts": {
                  "type": "array",
                  "items": {
                    "$ref": "artifact-reference.json"
                  }
                }
              }
            },
            "consumer_deployment": {
              "properties": {
                "artifacts": {
                  "type": "array",
                  "items": {
                    "$ref": "artifact-reference.json"
                  }
                }
              }
            },
            "dlq_redrive": {
              "properties": {
                "artifacts": {
                  "type": "array",
                  "items": {
                    "$ref": "artifact-reference.json"
                  }
                }
              }
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "applicable": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": [
                  "expand_contract",
                  "deployment_order",
                  "aggregator_environment",
                  "consumer_deployment",
                  "dlq_redrive"
                ],
                "properties": {
                  "expand_contract": {
                    "$ref": "#/$defs/rollout_dimension"
                  },
                  "deployment_order": {
                    "$ref": "#/$defs/rollout_dimension"
                  },
                  "aggregator_environment": {
                    "$ref": "#/$defs/rollout_dimension"
                  },
                  "consumer_deployment": {
                    "$ref": "#/$defs/rollout_dimension"
                  },
                  "dlq_redrive": {
                    "$ref": "#/$defs/rollout_dimension"
                  }
                }
              }
            }
          ]
        },
        "ui": {
          "type": "object",
          "required": [
            "applicable",
            "reason"
          ],
          "properties": {
            "applicable": {
              "type": "boolean"
            },
            "reason": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            "artifacts": {
              "type": "array",
              "items": {
                "$ref": "artifact-reference.json"
              }
            },
            "browser": {},
            "viewport": {},
            "functional_checks": {},
            "alignment_observations": {},
            "ux_observations": {}
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "applicable": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": [
                  "browser",
                  "viewport",
                  "functional_checks",
                  "alignment_observations",
                  "ux_observations",
                  "artifacts"
                ],
                "properties": {
                  "artifacts": {
                    "type": "array",
                    "items": {
                      "$ref": "artifact-reference.json"
                    },
                    "minItems": 1
                  },
                  "browser": {
                    "not": {
                      "enum": [
                        null,
                        false,
                        0,
                        "",
                        [],
                        {}
                      ]
                    }
                  },
                  "viewport": {
                    "not": {
                      "enum": [
                        null,
                        false,
                        0,
                        "",
                        [],
                        {}
                      ]
                    }
                  },
                  "functional_checks": {
                    "not": {
                      "enum": [
                        null,
                        false,
                        0,
                        "",
                        [],
                        {}
                      ]
                    }
                  },
                  "alignment_observations": {
                    "not": {
                      "enum": [
                        null,
                        false,
                        0,
                        "",
                        [],
                        {}
                      ]
                    }
                  },
                  "ux_observations": {
                    "not": {
                      "enum": [
                        null,
                        false,
                        0,
                        "",
                        [],
                        {}
                      ]
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "status": {
      "enum": [
        "APPROVED",
        "CHANGES_REQUIRED"
      ]
    },
    "kind": {
      "const": "architect-review-report-v2"
    },
    "document_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verification_authority_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blocking": {
      "type": "integer",
      "minimum": 0
    },
    "nonblocking": {
      "type": "integer",
      "minimum": 0
    },
    "core": {
      "type": "integer",
      "minimum": 0
    },
    "tests": {
      "type": "integer",
      "minimum": 0
    },
    "both": {
      "type": "integer",
      "minimum": 0
    },
    "counterexample_search": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation_ids",
          "scenario",
          "inspected_locations",
          "evidence",
          "result",
          "rationale"
        ],
        "properties": {
          "obligation_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "inspected_locations": {
            "$ref": "#/$defs/locations"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result": {
            "enum": [
              "found",
              "none_found",
              "blocked"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "For found/blocked results, runtime requires an unresolved ordinary BLOCKING finding anchored to a criterion ID of a selected obligation (not only an invariant) and CHANGES_REQUIRED; approval is forbidden."
    },
    "invariants": {
      "description": "Optional (#30): where each invariant is upheld. A later delta review uses these locations to decide whether a correction touched an approved invariant; an invariant without a recorded location forces a full re-review when anything changed. IDs must come from the current verification authority invariants registry; an empty registry permits no entries. This dynamic constraint is enforced by runtime.",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "locations"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "UPHELD",
              "VIOLATED"
            ]
          },
          "locations": {
            "$ref": "#/$defs/locations"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "fresh"
          }
        }
      },
      "then": {
        "required": [
          "counterexample_search"
        ],
        "not": {
          "required": [
            "prior_resolutions"
          ]
        },
        "properties": {
          "plan_defects": {
            "maxItems": 0
          },
          "findings": {
            "items": {
              "not": {
                "required": [
                  "resolution"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "compare"
          }
        }
      },
      "then": {
        "required": [
          "prior_resolutions",
          "plan_defects",
          "assessments"
        ],
        "not": {
          "required": [
            "counterexample_search"
          ]
        }
      }
    }
  ],
  "additionalProperties": false,
  "$defs": {
    "location": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^:]+(?::0*[1-9][0-9]*)?$"
        },
        {
          "type": "object",
          "required": [
            "artifact",
            "explanation"
          ],
          "additionalProperties": false,
          "properties": {
            "artifact": {
              "$ref": "artifact-reference.json"
            },
            "explanation": {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "rollout_dimension": {
      "type": "object",
      "required": [
        "status",
        "reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "EVIDENCED",
            "NOT_APPLICABLE"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "artifact-reference.json"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "EVIDENCED"
              }
            }
          },
          "then": {
            "required": [
              "artifacts"
            ],
            "properties": {
              "artifacts": {
                "type": "array",
                "items": {
                  "$ref": "artifact-reference.json"
                },
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
