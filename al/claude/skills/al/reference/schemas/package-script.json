{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "source-bound package-script check profile",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "unit",
    "script",
    "body_sha256",
    "intent",
    "manager",
    "closure",
    "semantic_coverage",
    "execution",
    "selected_by"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "package-script"
    },
    "unit": {
      "type": "string"
    },
    "script": {
      "type": "string"
    },
    "body_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "intent": {
      "enum": [
        "test",
        "lint",
        "typecheck",
        "check"
      ]
    },
    "manager": {
      "type": "object",
      "required": [
        "name",
        "version",
        "cwd",
        "lock",
        "inputs",
        "versions",
        "reason",
        "members"
      ],
      "properties": {
        "name": {
          "enum": [
            "npm",
            "pnpm",
            null
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "cwd": {
          "type": [
            "string",
            "null"
          ]
        },
        "lock": {
          "type": [
            "string",
            "null"
          ]
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "reason": {
          "type": "string"
        },
        "members": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "closure": {
      "type": "object",
      "required": [
        "sources",
        "reasons",
        "inputs"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "selector",
              "sha256"
            ],
            "properties": {
              "selector": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "semantic_coverage": {
      "type": "object",
      "required": [
        "status",
        "records",
        "kind",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "SUPPORTED",
            "UNVERIFIED"
          ]
        },
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "profile",
              "kind",
              "targets",
              "tool",
              "version",
              "config"
            ],
            "properties": {
              "profile": {
                "enum": [
                  "node-test",
                  "node-syntax",
                  "typescript",
                  "eslint",
                  "vitest",
                  "jest"
                ]
              },
              "kind": {
                "enum": [
                  "test",
                  "lint",
                  "typecheck",
                  "check"
                ]
              },
              "targets": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tool": {
                "type": "string"
              },
              "version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "config": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "additionalProperties": false
          }
        },
        "kind": {
          "enum": [
            "test",
            "lint",
            "typecheck",
            "check"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "READY",
            "PENDING"
          ]
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "selected_by": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "selector",
          "supported_invocation"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "selector": {
            "type": "string"
          },
          "supported_invocation": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
