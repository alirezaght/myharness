{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review-packet-v2",
  "type": "object",
  "required": [
    "attempt",
    "schema_version",
    "review_id",
    "stage",
    "candidate_hash",
    "task_hash",
    "task_package",
    "amendments",
    "candidate",
    "evidence",
    "gates",
    "kind",
    "document_hash",
    "verification_authority",
    "behavior",
    "rework_recovery_lineage",
    "repository_review_rules"
  ],
  "properties": {
    "attempt": {
      "$ref": "review-attempt.json"
    },
    "schema_version": {
      "const": 2
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "fresh",
        "compare"
      ]
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_package": {
      "type": "object"
    },
    "amendments": {
      "type": "array"
    },
    "candidate": {
      "type": "object"
    },
    "evidence": {
      "type": [
        "array",
        "object"
      ]
    },
    "gates": {
      "type": "array"
    },
    "escapes": {
      "type": "array"
    },
    "unverified": {
      "description": "Checks AL did not verify, as `gates status` lists them: pipeline-verified CI jobs and services, supervisor-recorded remote CI results, verbatim-recipe mappings, pre-existing and advisory failures. Notes for the reviewer; they never block.",
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "fresh": {
      "type": "object"
    },
    "prior_findings": {
      "type": "array"
    },
    "comparison_artifacts": {
      "type": "array"
    },
    "approved_inputs": {
      "type": "object"
    },
    "comparison_contents": {
      "type": "array"
    },
    "repository_review_rules": {
      "type": "object",
      "required": [
        "sources",
        "omissions",
        "discovery"
      ],
      "properties": {
        "sources": {
          "type": "array"
        },
        "omissions": {
          "type": "array"
        },
        "discovery": {
          "type": "string"
        }
      }
    },
    "kind": {
      "const": "review-packet-v2"
    },
    "document_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verification_authority": {
      "type": "object",
      "required": [
        "hash",
        "artifact"
      ],
      "additionalProperties": false,
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact": {
          "type": "object"
        }
      }
    },
    "behavior": {
      "type": "object"
    },
    "rework_recovery_lineage": {
      "type": [
        "object",
        "null"
      ]
    },
    "review_mode": {
      "description": "`delta` for an incremental correction-loop re-review (#30); absent for a full review.",
      "enum": [
        "delta"
      ]
    },
    "delta": {
      "description": "Delta review context (#30): the diff between the base review's snapshot and the candidate, the earlier findings with their status, the affected criteria and invariants, and the kept verdicts of unaffected criteria. The candidate, task package and approved plan are then hash references, not contents.",
      "type": "object",
      "required": [
        "base_review",
        "base_candidate",
        "base_snapshot",
        "paths",
        "diff",
        "diff_truncated",
        "prior_findings",
        "affected",
        "kept_verdicts"
      ],
      "additionalProperties": false,
      "properties": {
        "base_review": {
          "type": "string"
        },
        "base_candidate": {
          "type": "string"
        },
        "base_snapshot": {
          "type": "object"
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diff": {
          "type": "string"
        },
        "diff_truncated": {
          "type": "boolean"
        },
        "prior_findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "source",
              "severity",
              "status"
            ]
          }
        },
        "affected": {
          "type": "object",
          "required": [
            "criteria",
            "invariants"
          ]
        },
        "kept_verdicts": {
          "type": "array"
        },
        "handoff_records": {
          "description": "Compare stage only: implementer handoff records (agent-handoff-record-v1) stored since the base review, by hash with their original JSON.",
          "type": "array"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "compare"
          }
        }
      },
      "then": {
        "required": [
          "fresh",
          "prior_findings",
          "comparison_artifacts",
          "approved_inputs",
          "comparison_contents",
          "escapes"
        ],
        "properties": {
          "evidence": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "fresh"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "type": "array"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "fresh"
              ]
            },
            {
              "required": [
                "prior_findings"
              ]
            },
            {
              "required": [
                "comparison_artifacts"
              ]
            },
            {
              "required": [
                "approved_inputs"
              ]
            },
            {
              "required": [
                "comparison_contents"
              ]
            },
            {
              "required": [
                "escapes"
              ]
            }
          ]
        }
      }
    }
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "review_mode": [
      "delta"
    ],
    "delta": [
      "review_mode"
    ]
  }
}
