{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ci-context-artifact",
  "type": "object",
  "required": [
    "schema_version",
    "profile",
    "session_id",
    "run_id",
    "task_hash",
    "selection"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "task_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "selection": {
      "type": "object",
      "required": [
        "label"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "declaration": {
      "type": "object",
      "required": [
        "profile",
        "source"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "required": [
            "id",
            "kind",
            "sha256",
            "stored_path",
            "source",
            "captured_at"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "kind": {
              "const": "ci-context"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "stored_path": {
              "type": "string",
              "minLength": 1
            },
            "source": {
              "type": "string",
              "minLength": 1
            },
            "captured_at": {
              "type": "number"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    }
  }
}
