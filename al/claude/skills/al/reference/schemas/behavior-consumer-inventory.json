{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AL behavior consumer inventory", "type": "object", "additionalProperties": false,
  "required": ["applicability", "reason", "entries", "discovery_refs", "uncertainties"],
  "properties": {
    "applicability": {"enum": ["applicable", "not_applicable"]},
    "reason": {"type": "string", "minLength": 1},
    "discovery_refs": {"type": "array", "items": {"$ref": "artifact-reference.json"}},
    "uncertainties": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "entries": {
      "type": "array", "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "role", "kind", "contract", "locations", "source_refs"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "role": {"enum": ["producer", "consumer"]},
          "kind": {"enum": ["code", "link", "message", "export", "other"]},
          "contract": {"type": "string", "minLength": 1},
          "locations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_refs": {"type": "array", "items": {"$ref": "artifact-reference.json"}}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"applicability": {"const": "applicable"}}}, "then": {"properties": {"entries": {"minItems": 1}}}},
    {"if": {"properties": {"applicability": {"const": "not_applicable"}}}, "then": {"properties": {"entries": {"maxItems": 0}}}}
  ]
}
