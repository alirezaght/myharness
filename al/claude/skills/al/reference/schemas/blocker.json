{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task-scoped integration blocker input",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "tasks", "question", "context", "alternatives", "recommendation"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"},
    "tasks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"}},
    "question": {"type": "string", "minLength": 1, "maxLength": 65536, "pattern": "\\S"},
    "context": {"type": "string", "minLength": 1, "maxLength": 65536, "pattern": "\\S"},
    "alternatives": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "recommendation": {"type": "string", "minLength": 1, "maxLength": 65536, "pattern": "\\S"}
  }
}
