{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Versioned service-coverage declaration",
  "oneOf": [
    {
      "$ref": "#/$defs/v1"
    },
    {
      "$ref": "#/$defs/v2"
    }
  ],
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "adapter": {
      "oneOf": [
        {
          "const": {
            "id": "python",
            "version": 1
          }
        },
        {
          "const": {
            "id": "contract",
            "version": 1
          }
        }
      ]
    },
    "assessment": {
      "type": "object",
      "required": [
        "schema_version",
        "outcome",
        "known_affected",
        "potential_services",
        "selected_services",
        "dependency_uncertainties",
        "enumeration",
        "check_discovery",
        "required_bindings",
        "gaps"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "outcome": {
          "enum": [
            "identified",
            "exhaustive",
            "incomplete"
          ]
        },
        "known_affected": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "potential_services": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "selected_services": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "dependency_uncertainties": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "enumeration": {
          "$ref": "#/$defs/completeness"
        },
        "check_discovery": {
          "$ref": "#/$defs/completeness"
        },
        "required_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          }
        }
      }
    },
    "completeness": {
      "type": "object",
      "required": [
        "status",
        "gap_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "boundary_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "obligation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gap_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "gap": {
      "type": "object",
      "required": [
        "code",
        "path",
        "reason"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": "string"
        }
      }
    },
    "check": {
      "type": "object",
      "required": [
        "id",
        "category",
        "units",
        "required",
        "argv",
        "cwd",
        "execution_kind",
        "env_names",
        "sources",
        "required_scope",
        "source_chain",
        "obligation_ids",
        "execution_signature"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "category": {
          "enum": [
            "lint-imports",
            "ci"
          ]
        },
        "units": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required": {
          "const": true
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "execution_kind": {
          "enum": [
            "local",
            "remote"
          ]
        },
        "env_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sources": {
          "type": "array"
        },
        "required_scope": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_chain": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "sha256",
              "selector",
              "semantics"
            ],
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              },
              "selector": {
                "type": "string"
              },
              "semantics": {
                "type": "string"
              }
            }
          }
        },
        "obligation_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "execution_signature": {
          "$ref": "#/$defs/hash"
        },
        "remote_source": {
          "$ref": "gate-manifest.json#/$defs/github_source"
        },
        "package_script": {
          "$ref": "package-script.json"
        },
        "runner_resource": {
          "type": "object",
          "required": [
            "name",
            "version",
            "sha256"
          ],
          "properties": {
            "name": {
              "const": "al_architecture_check.py"
            },
            "version": {
              "const": 1
            },
            "sha256": {
              "$ref": "#/$defs/hash"
            }
          },
          "additionalProperties": false
        },
        "verification": {
          "oneOf": [
            {
              "type": "object"
            },
            {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          ]
        }
      }
    },
    "input_summary": {
      "type": "object",
      "required": [
        "count",
        "sha256"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      },
      "additionalProperties": false
    },
    "global_inventory": {
      "type": "object",
      "required": [
        "status",
        "diagnostic_ids"
      ],
      "properties": {
        "status": {
          "enum": [
            "complete",
            "incomplete"
          ]
        },
        "diagnostic_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    "assessment_v2": {
      "type": "object",
      "required": [
        "schema_version",
        "outcome",
        "known_affected",
        "potential_services",
        "selected_services",
        "dependency_uncertainties",
        "enumeration",
        "check_discovery",
        "required_bindings",
        "gaps",
        "global_inventory",
        "deferred_record_ids",
        "projection_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "outcome": {
          "enum": [
            "identified",
            "exhaustive",
            "incomplete"
          ]
        },
        "known_affected": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "potential_services": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "selected_services": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "dependency_uncertainties": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "enumeration": {
          "$ref": "#/$defs/completeness"
        },
        "check_discovery": {
          "$ref": "#/$defs/completeness"
        },
        "required_bindings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          }
        },
        "global_inventory": {
          "$ref": "#/$defs/global_inventory"
        },
        "deferred_record_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hash"
          }
        },
        "coverage_notes": {
          "description": "Coverage gaps outside the paths and units the change reaches: verification notes that never block.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/gap"
          }
        },
        "projection_sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "v1": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "service-coverage declaration",
      "type": "object",
      "required": [
        "schema_version",
        "adapter",
        "policy_version",
        "repository",
        "assessment",
        "semantic_requirements",
        "semantic_sha256",
        "provenance",
        "bindings"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "adapter": {
          "$ref": "#/$defs/adapter"
        },
        "policy_version": {
          "const": 1
        },
        "repository": {
          "type": "object",
          "required": [
            "root",
            "base_oid"
          ],
          "properties": {
            "root": {
              "type": "string"
            },
            "base_oid": {
              "type": "string"
            }
          }
        },
        "assessment": {
          "$ref": "#/$defs/assessment"
        },
        "semantic_requirements": {
          "type": "object"
        },
        "semantic_sha256": {
          "$ref": "#/$defs/hash"
        },
        "provenance": {
          "type": "object",
          "required": [
            "scan_inputs",
            "rule_sources",
            "membership",
            "absent_paths",
            "digest"
          ],
          "properties": {
            "scan_inputs": {
              "oneOf": [
                {
                  "type": "array"
                },
                {
                  "$ref": "#/$defs/input_summary"
                }
              ]
            },
            "rule_sources": {
              "type": "array"
            },
            "membership": {
              "type": "array"
            },
            "absent_paths": {
              "type": "array"
            },
            "digest": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "obligation_id",
              "gate_id",
              "execution_signature"
            ],
            "properties": {
              "obligation_id": {
                "type": "string"
              },
              "gate_id": {
                "type": "string"
              },
              "execution_signature": {
                "$ref": "#/$defs/hash"
              }
            }
          }
        }
      }
    },
    "v2": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "service-coverage declaration",
      "type": "object",
      "required": [
        "schema_version",
        "adapter",
        "policy_version",
        "repository",
        "assessment",
        "semantic_requirements",
        "semantic_sha256",
        "provenance",
        "bindings",
        "projection",
        "global_inventory",
        "capture"
      ],
      "properties": {
        "schema_version": {
          "const": 2
        },
        "adapter": {
          "$ref": "#/$defs/adapterV2"
        },
        "policy_version": {
          "const": 2
        },
        "repository": {
          "type": "object",
          "required": [
            "root",
            "base_oid"
          ],
          "properties": {
            "root": {
              "type": "string"
            },
            "base_oid": {
              "type": "string"
            }
          }
        },
        "assessment": {
          "$ref": "#/$defs/assessment_v2"
        },
        "semantic_requirements": {
          "type": "object"
        },
        "semantic_sha256": {
          "$ref": "#/$defs/hash"
        },
        "provenance": {
          "type": "object",
          "required": [
            "scan_inputs",
            "rule_sources",
            "membership",
            "absent_paths",
            "digest",
            "capture_sha256"
          ],
          "properties": {
            "scan_inputs": {
              "$ref": "#/$defs/input_summary"
            },
            "rule_sources": {
              "type": "array"
            },
            "membership": {
              "type": "array"
            },
            "absent_paths": {
              "type": "array"
            },
            "digest": {
              "$ref": "#/$defs/hash"
            },
            "capture_sha256": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "obligation_id",
              "gate_id",
              "execution_signature"
            ],
            "properties": {
              "obligation_id": {
                "type": "string"
              },
              "gate_id": {
                "type": "string"
              },
              "execution_signature": {
                "$ref": "#/$defs/hash"
              }
            }
          }
        },
        "projection": {
          "type": "object",
          "required": [
            "schema_version",
            "question",
            "selected_services",
            "relevant_gap_ids",
            "relevant_ci_ids",
            "deferred",
            "records",
            "ci_records",
            "semantic_sha256"
          ],
          "properties": {
            "schema_version": {
              "const": 2
            },
            "semantic_sha256": {
              "$ref": "#/$defs/hash"
            }
          }
        },
        "global_inventory": {
          "$ref": "#/$defs/global_inventory"
        },
        "capture": {
          "type": "object",
          "required": [
            "schema_version",
            "attempts",
            "stable",
            "discarded_attempts",
            "observations_digest",
            "implementation_binding",
            "source_count",
            "match_count",
            "absence_count"
          ],
          "properties": {
            "schema_version": {
              "const": 2
            },
            "attempts": {
              "enum": [
                1,
                2
              ]
            },
            "stable": {
              "const": true
            },
            "discarded_attempts": {
              "type": "array",
              "maxItems": 1
            },
            "observations_digest": {
              "$ref": "#/$defs/hash"
            },
            "implementation_binding": {
              "$ref": "#/$defs/hash"
            },
            "source_count": {
              "type": "integer",
              "minimum": 0
            },
            "match_count": {
              "type": "integer",
              "minimum": 0
            },
            "absence_count": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "adapterV2": {
      "oneOf": [
        {
          "const": {
            "id": "python",
            "version": 1
          }
        },
        {
          "const": {
            "id": "contract",
            "version": 1
          }
        },
        {
          "const": {
            "id": "conventional",
            "version": 1
          }
        },
        {
          "const": {
            "id": "contract",
            "version": 2
          }
        }
      ]
    }
  }
}
