{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "resolution-validation",
  "type": "object",
  "required": [
    "schema_version",
    "stage",
    "report_hash",
    "fresh_sha256",
    "comparison_sha256",
    "validated_fixes",
    "evidence_at_validation",
    "at"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "fresh_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "comparison_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validated_fixes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "stage",
          "kind",
          "id",
          "source",
          "resolution"
        ],
        "properties": {
          "stage": {
            "const": "compare"
          },
          "kind": {
            "const": "prior"
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "object"
          }
        }
      }
    },
    "evidence_at_validation": {
      "type": "object"
    },
    "at": {
      "type": "number"
    },
    "stage": {
      "const": "compare"
    },
    "report_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
