{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://myharness.invalid/al/execution-decision-v1.json",
  "title": "Harness developer decision delivery v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "binding", "blocker_id", "blocker_revision", "verdict", "text", "tasks", "criteria", "amendment", "registry", "base_revision"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/id"},
    "binding": {"$ref": "execution-event-v1.json#/$defs/binding"},
    "blocker_id": {"$ref": "#/$defs/id"},
    "blocker_revision": {"type": "integer", "minimum": 1},
    "verdict": {"enum": ["accept", "reject", "modify", "alternative"]},
    "text": {"type": "string", "minLength": 1, "maxLength": 65536},
    "tasks": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "criteria": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "amendment": {"type": "boolean"},
    "registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "minLength": 1}
      }
    },
    "base_revision": {"type": "string", "minLength": 1}
  },
  "$defs": {"id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,128}$"}}
}
