{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "architect-report-v2",
  "type": "object",
  "required": [
    "schema_version",
    "review_id",
    "stage",
    "invocation_id",
    "reviewer_role",
    "model",
    "task_hash",
    "candidate_hash",
    "packet_hash",
    "inspected_artifacts",
    "criteria",
    "findings",
    "status",
    "kind",
    "document_hash",
    "verification_authority_hash",
    "attempt_id",
    "effort",
    "policy_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "review_id": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "fresh",
        "compare"
      ]
    },
    "invocation_id": {
      "type": "string"
    },
    "reviewer_role": {
      "const": "al-architect"
    },
    "model": {
      "type": "string"
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "effort": {
      "type": "string",
      "minLength": 1
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_hash": {
      "type": "string"
    },
    "candidate_hash": {
      "type": "string"
    },
    "packet_hash": {
      "type": "string"
    },
    "inspected_artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "rationale",
          "locations",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "SATISFIED",
              "UNSATISFIED"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "locations": {
            "type": "array",
            "minItems": 1
          },
          "evidence": {
            "type": "array",
            "minItems": 1
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "severity",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "enum": [
              "BLOCKING",
              "NON_BLOCKING"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "resolution": {
            "type": "object",
            "required": [
              "status",
              "rationale",
              "locations",
              "evidence"
            ],
            "properties": {
              "status": {
                "enum": [
                  "fixed",
                  "disputed",
                  "deferred"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "locations": {
                "type": "array",
                "minItems": 1
              },
              "evidence": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    },
    "prior_resolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "source",
          "status",
          "rationale",
          "locations",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "status": {
            "enum": [
              "fixed",
              "unresolved",
              "deferred",
              "disputed"
            ]
          },
          "rationale": {
            "type": "string"
          },
          "locations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "plan_defects": {
      "type": "array"
    },
    "assessments": {
      "type": "object"
    },
    "status": {
      "enum": [
        "APPROVED",
        "CHANGES_REQUIRED"
      ]
    },
    "kind": {
      "const": "architect-review-report-v2"
    },
    "document_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verification_authority_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "blocking": {
      "type": "integer",
      "minimum": 0
    },
    "nonblocking": {
      "type": "integer",
      "minimum": 0
    },
    "core": {
      "type": "integer",
      "minimum": 0
    },
    "tests": {
      "type": "integer",
      "minimum": 0
    },
    "both": {
      "type": "integer",
      "minimum": 0
    },
    "counterexample_search": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "obligation_ids",
          "scenario",
          "inspected_locations",
          "evidence",
          "result",
          "rationale"
        ],
        "properties": {
          "obligation_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "scenario": {
            "type": "string",
            "minLength": 1
          },
          "inspected_locations": {
            "type": "array",
            "minItems": 1
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result": {
            "enum": [
              "found",
              "none_found",
              "blocked"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "fresh"
          }
        }
      },
      "then": {
        "required": [
          "counterexample_search"
        ],
        "not": {
          "required": [
            "prior_resolutions"
          ]
        },
        "properties": {
          "plan_defects": {
            "maxItems": 0
          },
          "findings": {
            "items": {
              "not": {
                "required": [
                  "resolution"
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "compare"
          }
        }
      },
      "then": {
        "required": [
          "prior_resolutions",
          "plan_defects",
          "assessments"
        ],
        "not": {
          "required": [
            "counterexample_search"
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
