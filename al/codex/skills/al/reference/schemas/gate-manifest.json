{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "gate-manifest",
  "type": "object",
  "required": ["schema_version", "base_oid", "paths", "units", "rules", "gates"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"description": "Optional discovery-assigned manifest identifier.", "type": "string", "minLength": 1},
    "revision": {"description": "Optional discovery-assigned revision.", "type": "integer", "minimum": 1},
    "base_oid": {"type": "string", "minLength": 1},
    "paths": {
      "description": "Selected and anticipated paths. Runtime inventory also retains previously declared paths and independently selected changes.",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "units": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "job": {"type": ["string", "null"]}
        }
      }
    },
    "gates": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "category", "applicability", "required", "reason", "units", "argv", "scope", "source", "execution_kind", "cwd"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "category": {"enum": ["lint-imports", "loc", "contracts", "pre-commit", "ci"]},
          "applicability": {"enum": ["APPLICABLE", "NOT_APPLICABLE", "UNRESOLVED"]},
          "required": {"type": "boolean"},
          "reason": {"type": ["string", "null"]},
          "units": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "argv": {"type": "array", "items": {"type": "string"}},
          "scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "source": {"$ref": "#/$defs/source"},
          "execution_kind": {"enum": ["local", "remote"]},
          "cwd": {"type": "string", "minLength": 1},
          "env_names": {
            "description": "Names only; values are never stored. Omission means an empty dependency set.",
            "default": [],
            "type": "array",
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}
          },
          "sources": {
            "description": "Optional explicit parent gitlink capability declarations. Omission is equivalent to an empty array for ordinary scopes.",
            "$ref": "evidence-sources.json"
          },
          "obligation_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "execution_signature": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "package_script": {"$ref": "package-script.json"}, "runner_resource": {
            "type": "object",
            "required": ["name", "version", "sha256"],
            "properties": {
              "name": {"const": "al_architecture_check.py"},
              "version": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          },
          "verification": {"type": "object"},
          "remote_source": {"$ref": "#/$defs/github_source"},
          "remote": {"oneOf": [{"type": "object", "required": ["provider", "repository_id", "run_id", "attempt", "job_id"], "properties": {"provider": {"const": "github"}, "repository_id": {"type": "integer", "minimum": 1}, "run_id": {"type": "integer", "minimum": 1}, "attempt": {"type": "integer", "minimum": 1}, "job_id": {"type": "integer", "minimum": 1}}, "additionalProperties": false}, {"type": "object", "required": ["provider", "project_id", "job_name"], "properties": {"provider": {"const": "gitlab"}, "project_id": {"type": ["integer", "string"]}, "job_name": {"type": "string", "minLength": 1}}}]},
          "ci_recipe": {
            "description": "Offered by discovery for a sourced CI job AL could not map: the job's verbatim before_script + script lines. A planner maps the job by making the gate APPLICABLE with exactly this argv; `gates plan` checks it against the independently reconstructed recipe.",
            "type": "object",
            "required": ["argv", "cwd", "execution_kind", "env_names", "semantics"],
            "properties": {"argv": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "cwd": {"const": "."}, "execution_kind": {"const": "local"}, "env_names": {"type": "array", "items": {"type": "string"}}, "semantics": {"type": "string"}},
            "additionalProperties": false
          }
        },
        "not": {"required": ["env"]}
      }
    },
    "service_coverage": {"$ref": "service-coverage.json"},
    "ci_context": {
      "description": "Optional, run-bound data artifact selecting one supported CI planning profile. Unsupported profiles stay unresolved.",
      "$ref": "ci-context-artifact.json#/$defs/declaration"
    }
  },
  "$defs": {
    "github_source": {"type": "object", "required": ["provider", "repository", "workflow_path", "job_key", "job_name", "runner_label", "steps", "verification_chain", "source_sha256", "semantics_version", "evidence_kind", "pytest_guard_status"], "properties": {"provider": {"const": "github"}, "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"}, "workflow_path": {"type": "string", "pattern": "^\\.github/workflows/[^/]+\\.ya?ml$"}, "job_key": {"type": "string"}, "job_name": {"type": "string"}, "runner_label": {"enum": ["ubuntu-latest", "macos-latest"]}, "steps": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"type": "object", "required": ["number", "name"], "properties": {"number": {"type": "integer", "minimum": 2}, "name": {"type": "string"}}, "additionalProperties": false}}, "verification_chain": {"type": "object"}, "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "semantics_version": {"const": 2}, "evidence_kind": {"const": "CI_JOB_ATTESTATION"}, "pytest_guard_status": {"const": "UNAVAILABLE"}}, "additionalProperties": false},
    "source": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["path", "sha256"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "job": {"type": ["string", "null"]}
          }
        }
      ]
    }
  }
}
