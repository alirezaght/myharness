{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "review-packet-v2",
  "type": "object",
  "required": [
    "attempt",
    "schema_version",
    "review_id",
    "stage",
    "candidate_hash",
    "task_hash",
    "task_package",
    "amendments",
    "candidate",
    "evidence",
    "gates",
    "kind",
    "document_hash",
    "verification_authority",
    "behavior",
    "rework_recovery_lineage",
    "repository_review_rules"
  ],
  "properties": {
    "attempt": {
      "$ref": "review-attempt.json"
    },
    "schema_version": {
      "const": 2
    },
    "review_id": {
      "type": "string",
      "minLength": 1
    },
    "stage": {
      "enum": [
        "fresh",
        "compare"
      ]
    },
    "candidate_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "task_package": {
      "type": "object"
    },
    "amendments": {
      "type": "array"
    },
    "candidate": {
      "type": "object"
    },
    "evidence": {
      "type": [
        "array",
        "object"
      ]
    },
    "gates": {
      "type": "array"
    },
    "escapes": {
      "type": "array"
    },
    "fresh": {
      "type": "object"
    },
    "prior_findings": {
      "type": "array"
    },
    "comparison_artifacts": {
      "type": "array"
    },
    "approved_inputs": {
      "type": "object"
    },
    "comparison_contents": {
      "type": "array"
    },
    "repository_review_rules": {
      "type": "object",
      "required": [
        "sources",
        "omissions",
        "discovery"
      ],
      "properties": {
        "sources": {
          "type": "array"
        },
        "omissions": {
          "type": "array"
        },
        "discovery": {
          "type": "string"
        }
      }
    },
    "kind": {
      "const": "review-packet-v2"
    },
    "document_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verification_authority": {
      "type": "object",
      "required": [
        "hash",
        "artifact"
      ],
      "additionalProperties": false,
      "properties": {
        "hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "artifact": {
          "type": "object"
        }
      }
    },
    "behavior": {
      "type": "object"
    },
    "rework_recovery_lineage": {
      "type": [
        "object",
        "null"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "stage": {
            "const": "compare"
          }
        }
      },
      "then": {
        "required": [
          "fresh",
          "prior_findings",
          "comparison_artifacts",
          "approved_inputs",
          "comparison_contents",
          "escapes"
        ],
        "properties": {
          "evidence": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "stage": {
            "const": "fresh"
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "type": "array"
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "fresh"
              ]
            },
            {
              "required": [
                "prior_findings"
              ]
            },
            {
              "required": [
                "comparison_artifacts"
              ]
            },
            {
              "required": [
                "approved_inputs"
              ]
            },
            {
              "required": [
                "comparison_contents"
              ]
            },
            {
              "required": [
                "escapes"
              ]
            }
          ]
        }
      }
    }
  ],
  "additionalProperties": false
}
