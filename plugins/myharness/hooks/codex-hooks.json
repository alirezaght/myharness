{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/bridge.py\" hook --host codex",
            "timeoutSec": 15
          }
        ]
      }
    ]
  }
}
